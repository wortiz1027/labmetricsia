{
	"name": "🍃 LabMetricsIA :: DevOpsMind Backend 🍃",
	"service": "devopsmind",
	"dockerComposeFile": "./containers/compose.yaml",
	"runArgs": [
		"--security-opt",
		"label=disable",
		"--network=ntw_ai",
		"--env-file"
	],
  	"runServices": [
		"mysql",
		"phpmyadmin",
		"postgres-pgvector",
		"pgadmin",
		"mongo",
		"mongo-express",
		"vault",
		"keycloak",
		"alloy",
		"tempo",
		"prometheus",
		"loki",
		"grafana"
	],
  	"hostRequirements": {
		"cpus": 2,
		"memory": "6gb",
		"storage": "5gb",
		"gpu": false
	},
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2.7.0": {
			"installZsh": true,
			"configureZshAsDefaultShell": true,
			"installOhMyZsh": true,
			"installOhMyZshConfig": true,
			"upgradePackages": true,
			"configureGpgWithGpgAgent": true
		},
		"ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
			"plugins": "zsh-autosuggestions zsh-syntax-highlighting",
			"omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions.git https://github.com/zsh-users/zsh-syntax-highlighting.git"
		},
		"ghcr.io/devcontainers/features/docker-in-docker:4.1.2": {
			"moby": "false"
		}
	},
    "customizations": {
		"projectMetadata": {
			"author": "@DevSoft Team",
			"repository": "git@github.com:wortiz1027/labmetricsia.git",
			"version": "1.0.0",
			"license": "MIT",
			"environment": "Development"
		},
		"vscode": {
			"extensions": [
				"esbenp.prettier-vscode",
				"esbenp.prettier-vscode",
				"EditorConfig.EditorConfig",
				"GraphQL.vscode-graphql",
				"redhat.vscode-yaml",
				"vscjava.vscode-java-pack",
				"vmware.vscode-boot-dev-pack",
				"GraphQL.vscode-graphql-syntax",
				"GitHub.github-vscode-theme",
				"zhuangtongfa.material-theme",
				"Semgrep.semgrep",
				"CucumberOpen.cucumber-official"
			],
			"settings": {
                "workbench.iconTheme": "symbols",
                "workbench.colorTheme": "Quiet Light",
                "git.blame.editorDecoration.enabled": true,
                "git.blame.statusBarItem.enabled": true,
                "scm.experimental.showHistoryGraph": true,
                "editor.renderLineHighlight": "none",
                "editor.cursorSmoothCaretAnimation": "off",
                "workbench.colorCustomizations": {
                    "git.blame.editorDecorationForeground": "#c7c7c788"
                },
                "editor.formatOnSave": true,
                "editor.codeActionsOnSave": {
                    "source.organizeImports": "explicit"
                },
                "dev.containers.forwardWayland": false,
                "terminal.integrated.defaultProfile.linux": "zsh",
                "git.autocrlf": "input",
                "editor.insertSpaces": true,
                "editor.tabSize": 4,
                "editor.renderIndentGuides": true,
                "java.compile.nullAnalysis.mode": "automatic",
                "java.jdt.ls.java.home": "/home/vscode/.local/share/mise/installs/java/latest",
                "sonarlint.ls.javaHome": "/home/vscode/.local/share/mise/installs/java/latest",
                "java.configuration.runtimes": [
                    {
                    "name": "JavaSE-25",
                    "path": "/home/vscode/.local/share/mise/installs/java/latest",
                    "default": true
                    }
                ],
                "spring-boot.livereload.enabled": true,
                "files.associations": {
                    "*.feature": "cucumber"
                },
                "cucumber.features": [
                    "src/test/resources/**/*.feature",
                    "features/**/*.feature"
                ],
                "cucumber.glue": [
                    "src/test/**/*.js",
                    "features/step_definitions/**/*.ts"
                ]
            }
        }
	},
	"forwardPorts": [
		8080,
		3000,
		3306,
		5432,
		27017,
		8081,
		8082,
		8083,
		8200,
		8089,
		4317,
		4318,
		12345,
		3200,
		9090,
		3100,
		3001,
		9084
	],
	"portsAttributes": {
		"8080": { "label": "Servidor Web Java Backend", "onAutoForward": "notify" },
		"3000": { "label": "Servidor Web Docsify", "onAutoForward": "notify" },
		"3306": { "label": "Servidor MySQL", "onAutoForward": "notify" },
		"5432": { "label": "Servidor PostgreSQL", "onAutoForward": "notify" },
		"27017": { "label": "Servidor MongoDB", "onAutoForward": "notify" },
		"8081": { "label": "Servidor PhpMyAdmin", "onAutoForward": "notify" },
		"8082": { "label": "Servidor PgAdmin", "onAutoForward": "notify" },
		"8083": { "label": "Servidor Mongo Express", "onAutoForward": "notify" },
		"8200": { "label": "Servidor Secret Manager", "onAutoForward": "notify" },
		"8089": { "label": "Servidor Autenticacion keycloak", "onAutoForward": "notify" },
		"4317": { "label": "Servidor grpc metrics", "onAutoForward": "notify" },
		"4318": { "label": "Servidor http metrics", "onAutoForward": "notify" },
		"12345": { "label": "Servidor --", "onAutoForward": "notify" },
		"3200": { "label": "Servidor Tempo UI", "onAutoForward": "notify" },
		"9090": { "label": "Servidor Prometheus", "onAutoForward": "notify" },
		"3100": { "label": "Servidor loki", "onAutoForward": "notify" },
		"3001": { "label": "Servidor Grafana", "onAutoForward": "notify" },
		"9084": { "label": "Servidor metricas actuator", "onAutoForward": "notify" }
	},
	"mounts": [
		"source=${localEnv:HOME}/.dotfiles/git/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.dotfiles/git/commit.template,target=/home/vscode/.config/git/commit.template,type=bind,consistency=cached"
	],
	"remoteEnv": {
		"MISE_TRUSTED_CONFIG_PATHS": "/workspaces",
		"JAVA_HOME": "/home/vscode/.local/share/mise/installs/java/latest",
		"GIT_SAFE_DIRECTORIES": "/workspaces"
	},
	"workspaceFolder": "/workspaces",
	"onCreateCommand": "sudo chmod 666 /var/run/docker.sock || true",
  	"initializeCommand": "./.devcontainer/devopsmind/scripts/sync-secrets.sh",
	"updateContentCommand": "chmod +x ./.devcontainer/devopsmind/scripts/boostrap.sh && bash ./.devcontainer/devopsmind/scripts/boostrap.sh && chmod +x ./.devcontainer/devopsmind/scripts/init-workspace.sh && chmod +x ./.devcontainer/devopsmind/scripts/load-env.sh && sh ./.devcontainer/devopsmind/scripts/init-workspace.sh && bash ./.devcontainer/devopsmind/scripts/load-env.sh",
	"postStartCommand": "rm -f ./.devcontainer/devopsmind/containers/.env",		
	"containerUser": "vscode",
	"remoteUser": "vscode"
}
